rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function leaderboardWriter() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validReplayShape() {
      return request.resource.data.replay == null
        || (
          request.resource.data.replay is map
          && request.resource.data.replay.keys().hasOnly([
            'version',
            'savedAt',
            'score',
            'maxHeight',
            'time',
            'seed',
            'duration',
            'canvasWidth',
            'canvasHeight',
            'isMobileRun',
            'viewportProfile',
            'aspectRatio',
            'platforms',
            'samples',
            'events'
          ])
          && request.resource.data.replay.version == 5
          && request.resource.data.replay.savedAt is number
          && request.resource.data.replay.score is number
          && request.resource.data.replay.score == request.resource.data.score
          && request.resource.data.replay.score >= 0
          && request.resource.data.replay.score <= 10000000
          && request.resource.data.replay.maxHeight is number
          && request.resource.data.replay.maxHeight == request.resource.data.maxHeight
          && request.resource.data.replay.maxHeight >= 0
          && request.resource.data.replay.maxHeight <= 100000
          && request.resource.data.replay.time is string
          && request.resource.data.replay.time == request.resource.data.time
          && request.resource.data.replay.time.size() <= 24
          && request.resource.data.replay.seed is string
          && request.resource.data.replay.seed == request.resource.data.seed
          && request.resource.data.replay.seed.size() > 0
          && request.resource.data.replay.seed.size() <= 24
          && request.resource.data.replay.duration is number
          && request.resource.data.replay.duration >= 0
          && request.resource.data.replay.duration <= 3600000
          && request.resource.data.replay.canvasWidth is number
          && request.resource.data.replay.canvasHeight is number
          && request.resource.data.replay.isMobileRun is bool
          && request.resource.data.replay.viewportProfile is string
          && request.resource.data.replay.viewportProfile.size() <= 16
          && request.resource.data.replay.aspectRatio is number
          && request.resource.data.replay.platforms is list
          && request.resource.data.replay.platforms.size() <= 1200
          && request.resource.data.replay.samples is list
          && request.resource.data.replay.samples.size() >= 5
          && request.resource.data.replay.samples.size() <= 4800
          && request.resource.data.replay.events is list
          && request.resource.data.replay.events.size() <= 500
        );
    }

    function validLeaderboardShape() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'displayName',
          'score',
          'maxHeight',
          'time',
          'seed',
          'replay',
          'timestamp',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.maxHeight is number
        && request.resource.data.maxHeight >= 0
        && request.resource.data.maxHeight <= 100000
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 24
        && request.resource.data.seed is string
        && request.resource.data.seed.size() > 0
        && request.resource.data.seed.size() <= 24
        && request.resource.data.updatedAt == request.time
        && validReplayShape();
    }

    function validProfileCreateShape() {
      return request.resource.data.keys().hasOnly([
          'alias',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.alias is string
        && request.resource.data.alias.size() > 0
        && request.resource.data.alias.size() <= 15
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validProfileUpdateShape() {
      return request.resource.data.keys().hasOnly([
          'alias',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.alias is string
        && request.resource.data.alias.size() > 0
        && request.resource.data.alias.size() <= 15
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function validAchievementStats() {
      return request.resource.data.stats is map
        && request.resource.data.stats.keys().hasOnly([
          'runs',
          'deaths',
          'bestHeight',
          'bestScore',
          'bestPerfectStreak'
        ])
        && request.resource.data.stats.keys().hasAll([
          'runs',
          'deaths',
          'bestHeight',
          'bestScore',
          'bestPerfectStreak'
        ])
        && request.resource.data.stats.runs is number
        && request.resource.data.stats.runs >= 0
        && request.resource.data.stats.runs <= 1000000
        && request.resource.data.stats.deaths is number
        && request.resource.data.stats.deaths >= 0
        && request.resource.data.stats.deaths <= 1000000
        && request.resource.data.stats.bestHeight is number
        && request.resource.data.stats.bestHeight >= 0
        && request.resource.data.stats.bestHeight <= 100000000
        && request.resource.data.stats.bestScore is number
        && request.resource.data.stats.bestScore >= 0
        && request.resource.data.stats.bestScore <= 10000000
        && request.resource.data.stats.bestPerfectStreak is number
        && request.resource.data.stats.bestPerfectStreak >= 0
        && request.resource.data.stats.bestPerfectStreak <= 100000;
    }

    function validAchievementUnlocked() {
      return request.resource.data.unlocked is map
        && request.resource.data.unlocked.keys().hasOnly([
          'first_run',
          'runs_10',
          'runs_50',
          'first_death',
          'deaths_10',
          'deaths_50',
          'deaths_100',
          'height_100',
          'height_500',
          'height_1000',
          'height_5000',
          'height_10000',
          'height_25000',
          'height_50000',
          'height_100000',
          'height_1000000',
          'height_100000000',
          'score_500',
          'score_1000',
          'score_5000',
          'score_10000',
          'score_20000',
          'score_30000',
          'score_40000',
          'score_50000',
          'perfect_3',
          'perfect_10',
          'perfect_25',
          'perfect_50',
          'perfect_100'
        ]);
    }

    function validAchievementShape() {
      return request.resource.data.keys().hasOnly([
          'stats',
          'unlocked',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && validAchievementStats()
        && validAchievementUnlocked();
    }

    match /leaderboard/{entryId} {
      allow read: if true;

      allow create: if leaderboardWriter()
        && validLeaderboardShape()
        && request.resource.data.timestamp == request.time;

      allow update: if leaderboardWriter()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.timestamp == resource.data.timestamp
        && validLeaderboardShape();

      allow delete: if false;
    }

    match /profiles/{profileId} {
      allow read: if signedIn()
        && request.auth.uid == profileId;

      allow create: if leaderboardWriter()
        && request.auth.uid == profileId
        && validProfileCreateShape();

      allow update: if leaderboardWriter()
        && request.auth.uid == profileId
        && validProfileUpdateShape();

      allow delete: if false;
    }

    match /achievements/{playerId} {
      allow read: if leaderboardWriter()
        && request.auth.uid == playerId;

      allow create, update: if leaderboardWriter()
        && request.auth.uid == playerId
        && validAchievementShape();

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
